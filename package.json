{
  "name": "kfm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter engine test && pnpm --filter web test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "supabase": "supabase",
    "gen:types": "supabase gen types typescript --local > web/src/lib/database.types.ts",
    "test:db": "./scripts/db-check.sh",
    "sync:engine": "./scripts/sync-engine.sh",
    "functions:serve": "pnpm sync:engine && supabase functions serve",
    "functions:deploy": "pnpm sync:engine && supabase functions deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "supabase": "^2.22.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  }
}
